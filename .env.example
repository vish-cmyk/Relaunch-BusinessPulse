# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted (used for Stripe checkout & portal redirects).
APP_URL="MY_APP_URL"

# STRIPE CONFIGURATION (NZD Monthly Membership Tiers: Starter NZ$29, Growth NZ$59, Business Plus NZ$99):
# Use sk_test_... and whsec_... for Stripe Test Mode before switching to sk_live_...
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# DURABLE PERSISTENCE & ADMIN SUSTAINABILITY MONITORING:
# FIREBASE_SERVICE_ACCOUNT: JSON string of Firebase service account credentials for durable server-side
# Firestore persistence of user subscriptions, usage quotas, and Stripe webhook deduplication.
FIREBASE_SERVICE_ACCOUNT=""

# BIZPULSE_DATA_DIR: Optional persistent disk directory for fallback state outside /tmp (e.g. /var/data/bizpulse).
BIZPULSE_DATA_DIR=""

# ADMIN_EMAILS: Comma-separated verified owner emails permitted to view /api/admin/metrics unit economics.
ADMIN_EMAILS=""
