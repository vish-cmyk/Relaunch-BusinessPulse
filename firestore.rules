rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated user can only read, write, update, and delete their own validated business cases
    match /users/{userId}/cases/{caseId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['id', 'profile', 'healthInputs'])
        && request.resource.data.id == caseId
        && request.resource.data.profile is map
        && request.resource.data.healthInputs is map;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
